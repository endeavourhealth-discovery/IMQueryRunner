{
  "name": "IMQueryRunner",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "test:unit": "vitest",
    "test:e2e": "gauge run --verbose --tags \"!qof-queries & !smh-queries\"",
    "test:e2e:ci": "cross-env headless_chrome=true screenshot_on_failure=true gauge run --tags \"!qof-queries & !smh-queries\"",
    "test:e2e:ci:qof-queries:parallel": "cross-env headless_chrome=true screenshot_on_failure=true gauge run --parallel -n 4 --tags qof-queries",
    "test:e2e:ci:smh-queries:parallel": "cross-env headless_chrome=true screenshot_on_failure=true gauge run --parallel -n 4 --tags smh-queries",
    "test:e2e:ci:reg-queries:parallel": "cross-env headless_chrome=true screenshot_on_failure=true gauge run --parallel -n 4 --tags reg-queries",
    "test:e2e:ci:parallel": "cross-env headless_chrome=true screenshot_on_failure=true gauge run --parallel -n 4 --tags \"!qof-queries & !smh-queries\"",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "drizzle-pull": "pnpm drizzle-pull-mysql",
    "drizzle-pull-mysql": "npx drizzle-kit pull --config=server/db/mysql.drizzle.ts",
    "format": "prettier --write \"{app,docs,enums,models,server,shared,types,tests}/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --write \"{app,docs,enums,models,server,shared,types,tests}/**/*.{js,ts,vue,json,css,scss,md}\"",
    "prepare": "husky",
    "preinstall": "pnpm config set \"@endeavour:registry=https://artifactory.endhealth.co.uk/repository/npm/\"",
    "sonar": "sonar-scanner-npm"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1098.0",
    "@braintree/sanitize-url": "7.1.2",
    "@endeavour/vue-library": "4.1.8",
    "@pinia/nuxt": "0.11.2",
    "@primeuix/themes": "2.0.3",
    "@tailwindcss/vite": "4.3.3",
    "casbin": "5.51.1",
    "casbin-basic-adapter": "1.3.0",
    "casdoor-nodejs-sdk": "1.34.0",
    "drizzle-orm": "1.0.0-beta.21",
    "drizzle-zod": "0.8.3",
    "engine.io": "6.6.9",
    "h3": "1.15.11",
    "lodash-es": "4.18.1",
    "murmurhash": "2.0.1",
    "mysql2": "3.23.2",
    "nuxt": "4.5.1",
    "object-hash": "3.0.0",
    "ofetch": "1.5.1",
    "perfect-debounce": "2.1.0",
    "pg": "8.22.0",
    "pinia": "4.0.2",
    "pino": "10.3.1",
    "primevue": "4.5.5",
    "rabbitmq-client": "5.0.8",
    "semver": "7.8.5",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tailwindcss": "4.3.3",
    "uuid": "11.1.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@getgauge/cli": "1.6.35",
    "@playwright/test": "1.62.0",
    "@primevue/nuxt-module": "4.5.5",
    "@sonar/scan": "5.0.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.9.5",
    "@types/object-hash": "3.0.6",
    "@types/pg": "8.20.0",
    "@types/semver": "7.7.1",
    "baseline-browser-mapping": "2.11.7",
    "cross-env": "10.1.0",
    "drizzle-kit": "1.0.0-rc.4-ca0f029",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.7.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "lint-staged": {
    "{app,docs,enums,models,server,shared,types,tests}/**/*.{js,ts,vue,json,css,scss,md}": "prettier --write"
  }
}