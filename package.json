{
  "name": "IMQueryRunner",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "test:unit": "vitest",
    "test:e2e": "gauge run --verbose",
    "test:e2e:ci": "cross-env headless_chrome=true screenshot_on_failure=true gauge run",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "drizzle-pull": "pnpm drizzle-pull-mysql",
    "drizzle-pull-mysql": "npx drizzle-kit pull --config=server/db/mysql.drizzle.ts",
    "format": "prettier --write \"{app,docs,enums,models,server,shared,types,tests}/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --write \"{app,docs,enums,models,server,shared,types,tests}/**/*.{js,ts,vue,json,css,scss,md}\"",
    "prepare": "husky",
    "preinstall": "pnpm config set \"@endeavour:registry=https://artifactory.endhealth.co.uk/repository/npm/\""
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.896.0",
    "@braintree/sanitize-url": "^7.1.2",
    "@endeavour/vue-library": "1.0.2",
    "@pinia/nuxt": "0.11.2",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.1.13",
    "casbin": "^5.39.0",
    "casbin-basic-adapter": "^1.3.0",
    "casdoor-nodejs-sdk": "^1.29.0",
    "drizzle-orm": "1.0.0-beta.21",
    "drizzle-zod": "^0.8.3",
    "engine.io": "^6.6.4",
    "h3": "^1.15.5",
    "lodash-es": "^4.17.23",
    "murmurhash": "^2.0.1",
    "mysql2": "^3.15.1",
    "nuxt": "^4.1.2",
    "object-hash": "^3.0.0",
    "ofetch": "^1.4.1",
    "perfect-debounce": "^2.0.0",
    "pg": "^8.16.3",
    "pinia": "^3.0.4",
    "pino": "^10.0.0",
    "primevue": "^4.5.5",
    "rabbitmq-client": "^5.0.5",
    "semver": "^7.7.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.13",
    "uuid": "^11.1.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@getgauge/cli": "^1.6.22",
    "@playwright/test": "^1.60.0",
    "@primevue/nuxt-module": "^4.3.9",
    "@sonar/scan": "^4.3.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/object-hash": "^3.0.6",
    "@types/pg": "^8.15.5",
    "@types/semver": "^7.7.1",
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "10.1.0",
    "drizzle-kit": "^1.0.0-beta.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.1.0"
  },
  "lint-staged": {
    "{app,docs,enums,models,server,shared,types,tests}/**/*.{js,ts,vue,json,css,scss,md}": "prettier --write"
  }
}
